# Optional server-side provider configuration. Leave blank to run the library without AI derivations/chat.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Authentication is enabled by default. On an empty database, startup fails closed
# until AUTH_INITIAL_ADMIN_PASSWORD is injected from a secret manager or a copied,
# untracked local .env file. There is intentionally no default administrator password.
AUTH_ENABLED=true
AUTH_INITIAL_ADMIN_USERNAME=admin
AUTH_INITIAL_ADMIN_PASSWORD=
# Session lifetime in seconds (default: 12 hours; allowed range: 900–2592000).
AUTH_SESSION_TTL_SECONDS=43200
# Keep true for HTTPS deployments. Local HTTP Compose overrides this to false;
# set it false only in an untracked local-development environment.
AUTH_COOKIE_SECURE=true

# Optional public-source integrations. Keep these values on the server only.
X_BEARER_TOKEN=
GITHUB_TOKEN=

# DATABASE_URL is optional for a native backend run. Docker Compose supplies its
# own internal PostgreSQL URL and does not expose the database port.
# DATABASE_URL=

# Optional development Vite proxy override. The default is http://127.0.0.1:8000.
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
